{
  "name": "gestor-fluxo-caixa",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "description": "Gestor de Fluxo de Caixa - Projeto Integrador UC5 (Electron + Vite + TypeScript)",
  "author": "Pedro Ezequiel Pontes da Silva",
  "scripts": {
    "dev": "vite",
    "build:win": "tsc && vite build && electron-builder",
    "start": "vite"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pg": "^8.22.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "electron": "^42.6.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.5",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "br.com.pedro.gestorfluxocaixa",
    "productName": "Gestor de Fluxo de Caixa",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!**/.env*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
